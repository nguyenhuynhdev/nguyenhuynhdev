  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "npm run build && wrangler pages dev out",
    "build": "next build --turbopack",
    "start": "next start",
    "deploy": "npm run build && npx wrangler pages deploy out",
    "db:create": "wrangler d1 create database",
    "db:update": "wrangler d1 execute database --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute database --local --file=./scripts/seed-data.sql",
    "db:deploy": "wrangler d1 execute database --file=./schema.sql --remote",
    "db:deploy:seed": "wrangler d1 execute database --file=./scripts/seed-data.sql --remote"
